{
  "manifest_version": 3,
  "name": "DeepForensic — Deepfake Audio Detector",
  "version": "1.3.0",
  "description": "Analiza audios y vídeos en redes sociales para detectar deepfake mediante IA y fase.",
  "permissions": ["storage", "activeTab", "contextMenus", "notifications"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://www.youtube.com/*",
    "https://twitter.com/*",
    "https://x.com/*",
    "https://www.instagram.com/*",
    "https://www.tiktok.com/*",
    "https://www.facebook.com/*",
    "https://fb.watch/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://twitter.com/*",
        "https://x.com/*",
        "https://www.instagram.com/*",
        "https://www.tiktok.com/*",
        "https://www.facebook.com/*",
        "https://fb.watch/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "DeepForensic Analyzer"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
